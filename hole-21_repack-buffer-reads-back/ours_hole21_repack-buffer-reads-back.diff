+static void ggml_backend_cpu_repack_buffer_get_tensor(ggml_backend_buffer_t buffer, const ggml_tensor * tensor,
+                                                       void * data, size_t offset, size_t size) {
+    // a view reads from the tensor it views: restore that one, then take the view's bytes
+    const ggml_tensor * src  = tensor->view_src ? tensor->view_src : tensor;
+    const size_t        base = tensor->view_src ? tensor->view_offs : 0;
+    const auto * tensor_traits = (const ggml::cpu::repack::tensor_traits_base *) src->extra;
+    GGML_ASSERT(tensor_traits != nullptr && "a tensor in a CPU_REPACK buffer has no repack traits");
+
+    const size_t nbytes = ggml_nbytes(src);
+    GGML_ASSERT(base + offset + size <= nbytes);
+    std::vector<uint8_t> whole;
+    void * plain = data;
+    if (src != tensor || offset != 0 || size != nbytes) {
+        whole.resize(nbytes);
+        plain = whole.data();
+    }
+    const int rc = tensor_traits->unpack(src, plain);
+    if (rc != 0) {
+        const char * why = rc == -1 ? "this layout's repack is not a fixed shuffle of bits" :
+                           rc == -3 ? "its shape does not divide into the layout's units" :
+                                      "the restored bytes did not repack to the bytes in memory";
+        GGML_ABORT("%s: cannot read repacked tensor %s (%s) back: %s; load the model without repacking "
+                   "(--no-repack, or use_extra_bufts = false) to read or save it", __func__, src->name,
+                   ggml_type_name(src->type), why);
+    }
+    if (plain != data) {
+        memcpy(data, (const uint8_t *) plain + base + offset, size);
+    }
+
+    GGML_UNUSED(buffer);
+}
