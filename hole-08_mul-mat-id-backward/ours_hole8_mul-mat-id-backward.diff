+// GGML_OP_MUL_MAT_ID backward, both as and b are parameters
+struct test_mul_mat_id_grad : public test_case {
+    const int n_mats;
+    const int n_used;
+    const bool b; // broadcast b matrix
+    const int64_t m;
+    const int64_t n;
+    const int64_t k;
+
+    std::string vars() override {
+        return VARS_TO_STR6(n_mats, n_used, b, m, n, k);
+    }
+
+    // the output is linear in every single parameter, a large step only reduces the rounding error
+    float grad_eps() override {
+        return 1.0f;
+    }
+
+    test_mul_mat_id_grad(int n_mats = 4, int n_used = 2, bool b = false, int64_t m = 6, int64_t n = 8, int64_t k = 8)
+        : n_mats(n_mats), n_used(n_used), b(b), m(m), n(n), k(k) {
+            GGML_ASSERT(n_used <= n_mats);
+            GGML_ASSERT(n*n_used >= n_mats);
+        }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * as = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, m, n_mats);
+        ggml_set_param(as);
+        ggml_set_name(as, "as");
+
+        ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_mats, n);
+        ggml_set_name(ids, "ids");
+        if (n_used != n_mats) {
+            ids = ggml_view_2d(ctx, ids, n_used, n, ids->nb[1], 0);
+            ggml_set_name(ids, "view_of_ids");
+        }
+
+        ggml_tensor * bt = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, this->b ? 1 : n_used, n);
+        ggml_set_param(bt);
+        ggml_set_name(bt, "b");
+
+        ggml_tensor * out = ggml_mul_mat_id(ctx, as, bt, ids);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_I32) {
+                init_tensor_uniform(t);
+                continue;
+            }
+            if (ggml_is_view_op(t->op)) {
+                continue;
+            }
+            // every expert must be used, an unused expert has a zero gradient and the error check gives NaN
+            for (int64_t r = 0; r < ggml_nrows(t); r++) {
+                std::vector<int32_t> data(t->ne[0]);
+                for (int i = 0; i < t->ne[0]; i++) {
+                    data[i] = (int32_t) ((r*n_used + i) % n_mats);
+                }
+                ggml_backend_tensor_set(t, data.data(), r * t->nb[1], t->ne[0] * sizeof(int32_t));
+            }
+        }
+    }
+};
