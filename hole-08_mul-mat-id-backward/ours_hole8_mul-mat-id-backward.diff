+// ggml_compute_forward_out_prod_id
+
+static void ggml_compute_forward_out_prod_id(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * b   = dst->src[0]; // [n, nB, n_tokens]
+    const struct ggml_tensor * c   = dst->src[1]; // [m, n_used, n_tokens]
+    const struct ggml_tensor * ids = dst->src[2]; // [n_used, n_tokens]
+
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(b->type   == GGML_TYPE_F32);
+    GGML_ASSERT(c->type   == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    GGML_ASSERT(b->nb[0] == sizeof(float));
+
+    const int64_t n     = b->ne[0];
+    const int64_t nB    = b->ne[1];
+    const int64_t m     = c->ne[0];
+    const int     n_ids = (int) ids->ne[0];
+    const int     n_as  = ggml_get_op_params_i32(dst, 0);
+
+    GGML_ASSERT(dst->ne[0] == n && dst->ne[1] == m && dst->ne[2] == n_as && dst->ne[3] == 1);
+    GGML_ASSERT(c->ne[1] == n_ids && c->ne[2] == ids->ne[1] && b->ne[2] == ids->ne[1]);
+    GGML_ASSERT(n_ids % nB == 0);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    void * wdata_cur = params->wdata;
+
+    int64_t * matrix_row_counts = // [n_as]
+        incr_ptr_aligned(&wdata_cur, n_as*sizeof(int64_t), sizeof(int64_t));
+
+    struct mmid_row_mapping * matrix_rows = // [n_as][ids->ne[0]*ids->ne[1]]
+        incr_ptr_aligned(&wdata_cur, n_as*ids->ne[0]*ids->ne[1]*sizeof(struct mmid_row_mapping), sizeof(int64_t));
+
+    GGML_ASSERT(params->wsize >= (size_t)((char *) wdata_cur - (char *) params->wdata));
+
+    if (ith == 0) {
+        memset(matrix_row_counts, 0, n_as*sizeof(int64_t));
+
+        // group (slot, token) pairs by expert, same as the forward pass
+        for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
+            for (int id = 0; id < n_ids; ++id) {
+                const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
+
+                GGML_ASSERT(i02 >= 0 && i02 < n_as);
+
+                MMID_MATRIX_ROW(i02, matrix_row_counts[i02]) = (struct mmid_row_mapping) {id, iid1};
+                matrix_row_counts[i02] += 1;
+            }
+        }
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // each thread writes its own rows j of every expert, experts with no pairs get zeros
+    const int64_t dm  = (m + nth - 1)/nth;
+    const int64_t ir0 = MIN(dm*ith, m);
+    const int64_t ir1 = MIN(ir0 + dm, m);
+
+    for (int e = 0; e < n_as; ++e) {
+        const int64_t cne = matrix_row_counts[e];
+
+        for (int64_t j = ir0; j < ir1; ++j) {
+            float * dst_row = (float *) ((char *) dst->data + j*dst->nb[1] + e*dst->nb[2]);
+
+            memset(dst_row, 0, n*sizeof(float));
+
+            for (int64_t p = 0; p < cne; ++p) {
+                const struct mmid_row_mapping pair = MMID_MATRIX_ROW(e, p);
+                const int64_t i = pair.i1; // slot
+                const int64_t t = pair.i2; // token
+
+                const float   g     = *(const float *) ((const char *) c->data + j*c->nb[0] + i*c->nb[1] + t*c->nb[2]);
+                const float * b_col =  (const float *) ((const char *) b->data + (i % nB)*b->nb[1] + t*b->nb[2]);
+
+                ggml_vec_mad_f32((int) n, dst_row, b_col, g);
+            }
+        }
+    }
+}
