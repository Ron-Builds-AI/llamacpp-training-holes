+// ggml_out_prod_id
+
+struct ggml_tensor * ggml_out_prod_id(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * c,
+        struct ggml_tensor  * ids,
+        int64_t               n_expert) {
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(ids->ne[2] == 1 && ids->ne[3] == 1); // ids is 2d
+    GGML_ASSERT(b->ne[3] == 1); // b is 3d
+    GGML_ASSERT(c->ne[3] == 1); // c is 3d
+    GGML_ASSERT(b->ne[2] == ids->ne[1]);
+    GGML_ASSERT(c->ne[2] == ids->ne[1]);
+    GGML_ASSERT(c->ne[1] == ids->ne[0]);
+    GGML_ASSERT(ids->ne[0] % b->ne[1] == 0); // same broadcast as ggml_mul_mat_id
+    GGML_ASSERT(n_expert >= 1 && n_expert <= INT32_MAX);
+
+    // the expert matrices are not a source, only their shape is needed
+    const int64_t ne[4] = { b->ne[0], c->ne[0], n_expert, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    ggml_set_op_params_i32(result, 0, (int32_t) n_expert);
+
+    result->op     = GGML_OP_OUT_PROD_ID;
+    result->src[0] = b;
+    result->src[1] = c;
+    result->src[2] = ids;
+
+    return result;
+}
